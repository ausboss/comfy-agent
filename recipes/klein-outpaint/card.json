{
 "title": "Klein 9B Outpaint (AusBoss): make a picture bigger",
 "does": "Extends a picture past its edges: give the pixels to add on each side and it paints a seamless continuation, then puts your picture back on top. From AusBoss's workflow of the same name on Civitai.",
 "inputs": {
  "image": {
   "set": "26.image",
   "type": "image",
   "required": true,
   "help": "the picture to extend"
  },
  "left": {
   "set": "26.pad_left",
   "default": 0,
   "help": "pixels to add on the left"
  },
  "right": {
   "set": "26.pad_right",
   "default": 0,
   "help": "pixels to add on the right"
  },
  "top": {
   "set": "26.pad_top",
   "default": 0,
   "help": "pixels to add on top"
  },
  "bottom": {
   "set": "26.pad_bottom",
   "default": 0,
   "help": "pixels to add at the bottom"
  },
  "seed": {
   "set": [
    "13.seed"
   ],
   "default": "random",
   "help": "same seed and settings give the same result"
  }
 },
 "tips": [
  "To turn a square picture into a wide one, add about half its width to left and right together, split evenly.",
  "At least one side must be more than 0, or nothing changes."
 ],
